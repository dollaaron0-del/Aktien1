# === Pflichtfeld (bei LLM_PROVIDER=anthropic) ===
ANTHROPIC_API_KEY=sk-ant-...

# === LLM-Provider-Umschalter (analyzers/llm_client.py) ===
# "anthropic" (Default) = Claude wie bisher.
# "gemini"              = Google Gemini (spart Claude-API-Kosten/Wochenlimit),
#                         dann GEMINI_API_KEY Pflicht.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_MODEL_LIGHT=gemini-3.1-flash-lite

# === Reddit (kostenlos: https://www.reddit.com/prefs/apps) ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockSentimentBot/1.0 by YourUsername

# === NewsAPI (kostenlos Tier: https://newsapi.org) ===
NEWSAPI_KEY=

# === Twitter/X (optional, Paid: https://developer.twitter.com) ===
# TWITTER_BEARER_TOKEN=

# === Broker-Modus ===
# "paper"   -> Simulation mit echten Marktdaten (Standard, kein Konto nötig)
# "alpaca"  -> Alpaca Markets API (US-Aktien, kostenlos: https://alpaca.markets)
# "ibkr"    -> Interactive Brokers (erfordert TWS/Gateway laufend)
BROKER_MODE=paper
INITIAL_CAPITAL=10000.0

# === Alpaca (nur wenn BROKER_MODE=alpaca) ===
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# === Telegram Benachrichtigungen (optional) ===
# 1. BotFather auf Telegram → /newbot → Token kopieren
# 2. Bot starten, dann: https://api.telegram.org/bot<TOKEN>/getUpdates → Chat-ID kopieren
# TELEGRAM_BOT_TOKEN=123456789:AABBCCddEEff...
# TELEGRAM_CHAT_ID=987654321

# === Fokus-Modus ===
# WEALTH_BUILDING   – Aggressives Compounding (Standard)
# INCOME            – Konservativ, schnelle TPs, monatl. Ausschüttungen priorisiert
# TARGET_GOAL       – Zielbetrag bis Zieldatum (skaliert Risiko dynamisch)
FOCUS_MODE=WEALTH_BUILDING
# Nur für TARGET_GOAL:
# TARGET_GOAL_AMOUNT=50000
# TARGET_GOAL_DATE=2027-12-31

# === Portfolio-Ziele & Ausschüttung ===
# Wachstumsphase endet wenn Portfolio = INITIAL_CAPITAL × GROWTH_TARGET_MULTIPLE
GROWTH_TARGET_MULTIPLE=3.0
# Gewünschte monatliche Ausschüttung (€/$) in der Ausschüttungsphase
MONTHLY_DISTRIBUTION_EUR=500.0
# Sicherheitspuffer: Monate × Zielausschüttung bleiben immer im Portfolio
DISTRIBUTION_BUFFER_MONTHS=6

# === Marktbasierter Analyse-Zeitplan ===
# Vollanalyse läuft automatisch X Minuten vor Börseneröffnung.
# Zeiten werden automatisch für Sommer-/Winterzeit (DST) korrigiert.
# Wochenden werden übersprungen.
#
# Verfügbare Börsen-Codes:
#   XETRA  = Frankfurt      09:00 CET/CEST
#   NYSE   = New York       09:30 ET
#   NASDAQ = New York       09:30 ET  (identisch mit NYSE)
#   TSE    = Tokyo          09:00 JST (kein DST)
#   HKEX   = Hong Kong      09:30 HKT (kein DST)
#   SSE    = Shanghai       09:30 CST (kein DST)
#   LSE    = London         08:00 GMT/BST
#   ASX    = Sydney         10:00 AEST/AEDT
MARKET_EXCHANGES=XETRA,NYSE,TSE

# Vorlauf vor Börseneröffnung in Minuten
MARKET_LEAD_MINUTES=30

# Stündlicher Social-Scan (Reddit + StockTwits, ohne Claude-Kosten)
ENABLE_SOCIAL_SCAN=true

# Signal-Warteschlange: Signale ohne freies Kapital verfallen nach N Stunden
SIGNAL_QUEUE_MAX_AGE_HOURS=48

# === Risiko-Filter ===
# Neue Käufe blockieren wenn Earnings innerhalb N Tagen
BLOCK_EARNINGS_DAYS=5
# Maximaler Anteil pro Sektor (0.40 = 40%)
MAX_SECTOR_PCT=0.40

# === Kelly-Criterion-Positionsgröße ===
# true = optimale Größe aus historischer Win-Rate (braucht ≥10 geschlossene Trades)
USE_KELLY_SIZING=false
KELLY_FRACTION=0.25

# === Watchlist-Scanner ===
AUTO_SCAN_WATCHLIST=false
SCAN_MAX_PICKS=3

# === Markt-Hedge / Rezessions-Absicherung ===
# Inverse ETFs kaufen wenn Rezessions-Score den Schwellwert erreicht
# Aktivieren/deaktivieren
ENABLE_HEDGING=true

# Ab welchem Regime hedgen: NEUTRAL | BEAR | CRISIS (Standard: BEAR)
# NEUTRAL = sehr früh sichern, CRISIS = nur bei echtem Crash
HEDGE_FROM_REGIME=BEAR

# Maximaler Portfolio-Anteil für Hedge-Positionen (0.20 = 20%)
MAX_HEDGE_PCT=0.20

# Alle N Stunden Regime prüfen (zwischen Vollanalysen)
REGIME_CHECK_INTERVAL_HOURS=6

# Wie inverse ETFs gewählt werden (automatisch, kein manueller Eingriff nötig):
#   BEAR-Regime:   SH  (1× Short S&P500)  + ggf. PSQ (1× Short NASDAQ)
#   CRISIS-Regime: SDS (2× Short S&P500)  + SQQQ (3× Short NASDAQ)
#   Tech-Bubble:   PSQ / SQQQ
#   Finanz-Krise:  SEF / FAZ
#   Energie-Crash: DDG / ERY

# === Margin / Hebel – Progressives Tier-System ===
# false = kein Hebel (Standard, empfohlen bis Bot Track-Record hat)
# true  = Bot verdient sich Hebel selbst durch Performance:
#           Tier 1: 1.25× ab 20 Trades, 60% Win-Rate
#           Tier 2: 1.50× ab 35 Trades, 63% Win-Rate
#           Tier 3: 1.75× ab 55 Trades, 67% Win-Rate
#           Tier 4: 2.00× ab 80 Trades, 72% Win-Rate
#         Bei schlechter Performance → automatische Rückstufung
# Erfordert Alpaca Margin-Account (nicht Cash-Account)!
# Status prüfen: python main.py --margin
USE_MARGIN=false
# Nur bei dieser Konfidenz Hebel nutzen
# MARGIN_MIN_CONFIDENCE=HIGH

# === Ollama (lokales KI-Modell, optional – für Mac mini M5) ===
# false = nur Claude API (Standard, kein Mac mini nötig)
# true  = Ollama filtert vor, Claude bestätigt → spart ~50% API-Kosten
OLLAMA_ENABLED=false
# OLLAMA_URL=http://localhost:11434
# Empfohlene Modelle je RAM:
#   16 GB → llama3.1:8b
#   24 GB → qwen2.5:14b
#   32 GB → qwen2.5:32b
#   48 GB → llama3.3:70b
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT=30
# Tier-System (system/resource_manager.py) überschreibt OLLAMA_MODEL je nach
# RAM/Idle-Tier. Auf CPU-only-Servern (Tier MINIMAL) greift OLLAMA_MODEL NICHT —
# dort zählt OLLAMA_MODEL_MINIMAL. Auf schwacher Hardware alle drei auf 3b setzen:
# OLLAMA_MODEL_MINIMAL=llama3.2:3b
# OLLAMA_MODEL_BALANCED=llama3.2:3b
# OLLAMA_MODEL_PERFORMANCE=llama3.2:3b

# === API-Kostenüberwachung ===
# Geschätzte Kosten pro Claude-Aufruf (claude-opus-4-7, ~$0.135)
# Wird im Dashboard angezeigt und in data/api_savings.json gespeichert
# CLAUDE_COST_PER_CALL=0.135
# Hartes Tages-Budget für Claude-Calls (analyzers/api_cost_tracker.py).
# MAX_DAILY_COST_EUR hat Vorrang; sonst gilt MAX_DAILY_COST_USD als Limit.
# MAX_DAILY_COST_EUR=1.00
