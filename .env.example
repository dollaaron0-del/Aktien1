# === Pflichtfeld ===
ANTHROPIC_API_KEY=sk-ant-...

# === Reddit (kostenlos: https://www.reddit.com/prefs/apps) ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockSentimentBot/1.0 by YourUsername

# === NewsAPI (kostenlos Tier: https://newsapi.org) ===
NEWSAPI_KEY=

# === Twitter/X (optional, Paid: https://developer.twitter.com) ===
# TWITTER_BEARER_TOKEN=

# === Broker-Modus ===
# "paper"   -> Simulation mit echten Marktdaten (Standard, kein Konto nötig)
# "alpaca"  -> Alpaca Markets API (US-Aktien, kostenlos: https://alpaca.markets)
# "ibkr"    -> Interactive Brokers (erfordert TWS/Gateway laufend)
BROKER_MODE=paper
INITIAL_CAPITAL=10000.0

# === Alpaca (nur wenn BROKER_MODE=alpaca) ===
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# === Telegram Benachrichtigungen (optional) ===
# 1. BotFather auf Telegram → /newbot → Token kopieren
# 2. Bot starten, dann: https://api.telegram.org/bot<TOKEN>/getUpdates → Chat-ID kopieren
# TELEGRAM_BOT_TOKEN=123456789:AABBCCddEEff...
# TELEGRAM_CHAT_ID=987654321

# === Fokus-Modus ===
# WEALTH_BUILDING   – Aggressives Compounding (Standard)
# INCOME            – Konservativ, schnelle TPs, monatl. Ausschüttungen priorisiert
# TARGET_GOAL       – Zielbetrag bis Zieldatum (skaliert Risiko dynamisch)
FOCUS_MODE=WEALTH_BUILDING
# Nur für TARGET_GOAL:
# TARGET_GOAL_AMOUNT=50000
# TARGET_GOAL_DATE=2027-12-31

# === Portfolio-Ziele & Ausschüttung ===
# Wachstumsphase endet wenn Portfolio = INITIAL_CAPITAL × GROWTH_TARGET_MULTIPLE
GROWTH_TARGET_MULTIPLE=3.0
# Gewünschte monatliche Ausschüttung (€/$) in der Ausschüttungsphase
MONTHLY_DISTRIBUTION_EUR=500.0
# Sicherheitspuffer: Monate × Zielausschüttung bleiben immer im Portfolio
DISTRIBUTION_BUFFER_MONTHS=6

# === Risiko-Filter ===
# Neue Käufe blockieren wenn Earnings innerhalb N Tagen
BLOCK_EARNINGS_DAYS=5
# Maximaler Anteil pro Sektor (0.40 = 40%)
MAX_SECTOR_PCT=0.40

# === Kelly-Criterion-Positionsgröße ===
# true = optimale Größe aus historischer Win-Rate (braucht ≥10 geschlossene Trades)
USE_KELLY_SIZING=false
KELLY_FRACTION=0.25

# === Watchlist-Scanner ===
AUTO_SCAN_WATCHLIST=false
SCAN_MAX_PICKS=3
