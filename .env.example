# === Pflichtfeld ===
ANTHROPIC_API_KEY=sk-ant-...

# === Reddit (kostenlos: https://www.reddit.com/prefs/apps) ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockSentimentBot/1.0 by YourUsername

# === NewsAPI (kostenlos Tier: https://newsapi.org) ===
NEWSAPI_KEY=

# === Twitter/X (optional, Paid: https://developer.twitter.com) ===
# TWITTER_BEARER_TOKEN=

# === Broker-Modus ===
# "paper"   -> Simulation mit echten Marktdaten (Standard, kein Konto nötig)
# "alpaca"  -> Alpaca Markets API (US-Aktien, kostenlos: https://alpaca.markets)
# "ibkr"    -> Interactive Brokers (erfordert TWS/Gateway laufend)
BROKER_MODE=paper
INITIAL_CAPITAL=10000.0

# === Alpaca (nur wenn BROKER_MODE=alpaca) ===
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# === Portfolio-Ziele & Ausschüttung ===
# Wachstumsphase endet wenn Portfolio = INITIAL_CAPITAL × GROWTH_TARGET_MULTIPLE
GROWTH_TARGET_MULTIPLE=3.0
# Gewünschte monatliche Ausschüttung (€/$) in der Ausschüttungsphase
MONTHLY_DISTRIBUTION_EUR=500.0
# Sicherheitspuffer: Monate × Zielausschüttung bleiben immer im Portfolio
DISTRIBUTION_BUFFER_MONTHS=6
