# ═══════════════════════════════════════════════════════════════════════════════
# Aktien-Bot – Konfiguration
# Datei kopieren: cp env.example .env
# Dann .env mit eigenen Werten befüllen.
# NIEMALS .env in Git committen!
# ═══════════════════════════════════════════════════════════════════════════════

# ── API-Keys (Pflicht) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...           # claude.ai/settings → API Keys
TELEGRAM_BOT_TOKEN=...                 # BotFather → /newbot
TELEGRAM_CHAT_ID=...                   # @userinfobot → deine Chat-ID

# ── API-Keys (Optional) ───────────────────────────────────────────────────────
NEWSAPI_KEY=                           # newsapi.org (kostenlos bis 100 req/Tag)
REDDIT_CLIENT_ID=                      # reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockSentimentBot/1.0
TWITTER_BEARER_TOKEN=                  # developer.twitter.com (optional)
AISSTREAM_API_KEY=                     # aisstream.io (kostenlos; nur f. Tanker-Flow-Experiment)
FRED_API_KEY=                          # fred.stlouisfed.org (kostenlos; Makro-Risikoreihen)
EIA_API_KEY=                           # eia.gov/opendata (kostenlos; Rohöl-Lagerbestände)
ENTSOE_API_TOKEN=                      # transparency.entsoe.eu (kostenlos; EU-Stromlast)

# ── Broker ────────────────────────────────────────────────────────────────────
# paper  = simulierter Handel (kein echtes Geld, Standard)
# alpaca = Alpaca Markets (US-Aktien, Paper- oder Live-Modus)
# ibkr   = Interactive Brokers (TWS oder IB Gateway muss laufen)
BROKER_MODE=paper

# Alpaca (nur wenn BROKER_MODE=alpaca)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # Paper: paper-api | Live: api.alpaca.markets

# IBKR / Interactive Brokers (nur wenn BROKER_MODE=ibkr)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # TWS Live: 7496 | TWS Paper: 7497 | IB Gateway Live: 4001 | Gateway Paper: 4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=           # Leer lassen = Haupt-Account automatisch

# ── Kapital & Ziele ───────────────────────────────────────────────────────────
INITIAL_CAPITAL=10000.0

# Fokus-Modus: WEALTH_BUILDING | INCOME | CAPITAL_PRESERVATION
FOCUS_MODE=WEALTH_BUILDING

# Optionales Renditeziel (leer lassen = kein Ziel)
TARGET_GOAL_AMOUNT=50000
TARGET_GOAL_DATE=2028-12-31

# ── Watchlist ────────────────────────────────────────────────────────────────
# Komma-getrennte Ticker (leer = Standard-Watchlist aus Code)
WATCHLIST=AAPL,MSFT,NVDA,TSLA,GOOGL,AMZN,META,JPM,V,LLY

# Auto-Scan: Bot sucht selbst nach interessanten Aktien (langsamer)
AUTO_SCAN_WATCHLIST=false
SCAN_MAX_PICKS=3

# ── Markt-Zeitplan ────────────────────────────────────────────────────────────
# Welche Börsen überwacht werden (Analyse startet 30 Min vor Open)
# Verfügbar: NYSE, NASDAQ, XETRA, LSE, TSE, HKEX
MARKET_EXCHANGES=NYSE,XETRA

# Wie viele Minuten vor Börseneröffnung die Analyse starten soll
MARKET_LEAD_MINUTES=30

# ── Krypto ────────────────────────────────────────────────────────────────────
# Krypto in den normalen Analyse-Zyklus aufnehmen
CRYPTO_ENABLED=false
CRYPTO_WATCHLIST=BTC,ETH,SOL
CRYPTO_MAX_PORTFOLIO_PCT=0.15    # Max 15% des Portfolios in Krypto
CRYPTO_STOP_LOSS_PCT=0.10        # 10% Stop-Loss für Krypto
CRYPTO_TAKE_PROFIT_PCT=0.25      # 25% Take-Profit für Krypto

# ── EU-Aktien ────────────────────────────────────────────────────────────────
EU_STOCKS_ENABLED=false
# Manuelle EU-Watchlist (leer = Auto-Scanner sucht Top-Kandidaten)
EU_WATCHLIST=SAP.DE,ASML.AS,LVMH.PA

# ── Risiko & Sizing ───────────────────────────────────────────────────────────
MAX_SECTOR_PCT=0.40       # Max 40% des Portfolios in einem Sektor
USE_KELLY_SIZING=false    # Kelly-Criterion für Positionsgröße
KELLY_FRACTION=0.25       # Kelly-Anteil (0.25 = Quarter-Kelly, konservativ)
USE_MARGIN=false          # Marginhandel aktivieren (nur für erfahrene Trader)

# ── Hedging ───────────────────────────────────────────────────────────────────
ENABLE_HEDGING=true       # Automatische Inverse-ETF Absicherung bei BEAR-Regime
# Max Portfolioanteil für alle Krisen-Instrumente zusammen:
# Inverse ETFs + Volatilitäts-ETFs + Sichere Häfen + Defensive Sektoren
MAX_HEDGE_PCT=0.35        # 35% erlaubt bei voller CRISIS-Allokation
HEDGE_FROM_REGIME=BEAR    # Ab welchem Regime gehedgt wird (BEAR oder CRISIS)

# ── Signale & Warteschlange ───────────────────────────────────────────────────
SIGNAL_QUEUE_MAX_AGE_HOURS=48   # Signale die älter sind werden verworfen
BLOCK_EARNINGS_DAYS=5           # Keine neuen Käufe X Tage vor Earnings
ENABLE_SOCIAL_SCAN=true         # Reddit/Twitter Sentiment vor der Analyse sammeln

# ── Claude AI ────────────────────────────────────────────────────────────────
# Verfügbare Modelle: claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-opus-4-7
# Leichtes Modell für Nebenaufrufe (Thesis-/Exit-Check offener Positionen).
# Haiku ~1/3 der Sonnet-Kosten; die finale Katalysator-Analyse bleibt auf
# CLAUDE_MODEL. Leer → nutzt CLAUDE_MODEL (kein Tiering).
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
# Prompt-Cache-TTL für System-Prompt + Makro/Geo-Kontext (pro Zyklus konstant).
# "1h" hält den Cache über den ganzen Zyklus warm (sonst 5-min-Default → läuft
# zwischen langsamen CPU-Tickern ab → Vollpreis). Erlaubt: 5m | 1h.
CLAUDE_CACHE_TTL=1h
# Dedup: identische News (gleicher Fingerprint) je Ticker werden innerhalb
# dieser Spanne nicht erneut an Claude geschickt – letztes Vollergebnis wird
# wiederverwendet (nur Neueinstiege; Thesis-Checks hängen am Live-Preis). 0 = aus.
CLAUDE_RESULT_CACHE_HOURS=6

# Kosten-Limit pro Tag (0 = unbegrenzt)
CLAUDE_DAILY_COST_LIMIT_USD=5.00
# Hartes Tages-Budget für Claude-Calls (analyzers/api_cost_tracker.py).
# MAX_DAILY_COST_EUR hat Vorrang; ist nur MAX_DAILY_COST_USD gesetzt, gilt dessen Wert.
MAX_DAILY_COST_EUR=1.00

# ── Lokales LLM (Optional, Ollama) ───────────────────────────────────────────
# Empfehlung je nach RAM:
#   < 16 GB RAM, CPU-only : llama3.2:3b     (~2 GB, ~5–15s/Analyse)
#   16–24 GB RAM, CPU-only: llama3.1:8b     (~5 GB, ~30–60s/Analyse) → Timeout anpassen
#   24+ GB RAM, CPU-only  : qwen2.5:14b     (~9 GB, ~60–90s/Analyse) → Timeout anpassen
#   GPU vorhanden         : llama3.3:70b    (~40 GB, ~5–10s/Analyse)
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60
# Adaptives Tier-System (system/resource_manager.py) überschreibt OLLAMA_MODEL je
# nach RAM/Idle-Tier. Auf CPU-only-Servern (Tier MINIMAL) greift OLLAMA_MODEL NICHT —
# dort zählt OLLAMA_MODEL_MINIMAL. Auf schwacher Hardware alle drei auf 3b setzen:
OLLAMA_MODEL_MINIMAL=llama3.2:3b
OLLAMA_MODEL_BALANCED=llama3.2:3b
OLLAMA_MODEL_PERFORMANCE=llama3.2:3b

# ── Multi-Timeframe Bestätigung ───────────────────────────────────────────────
MTF_CONFIRMATION_ENABLED=false   # Zusätzliche Bestätigung auf Wochen-Timeframe

# ── VIX-Risikoschutz ─────────────────────────────────────────────────────────
VIX_RISK_ENABLED=true            # Keine neuen Käufe wenn VIX > Schwelle

# ── TradingView Webhook (Optional) ───────────────────────────────────────────
TRADINGVIEW_WEBHOOK_ENABLED=false
TRADINGVIEW_WEBHOOK_PORT=8080
TRADINGVIEW_WEBHOOK_SECRET=      # Geheimes Token für Webhook-Authentifizierung

# ── Prometheus Monitoring (Optional) ─────────────────────────────────────────
# Metriken abrufbar unter http://localhost:8000/metrics
PROMETHEUS_PORT=0               # 0 = deaktiviert, z.B. 8000 = aktiv

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR

# ── Turbo-Modus (NUR Paper-Trading!) ─────────────────────────────────────────
# Maximale Aggressivität: alle Sicherheitsfilter deaktiviert.
# Zweck: testen ob rücksichtslose Gewinnoptimierung profitabel ist oder nicht.
# ACHTUNG: Nur mit BROKER_MODE=paper verwenden – bei Live-Brokern ignoriert!
TURBO_MODE=false
TURBO_MAX_POSITION_PCT=0.40   # 40 % des Portfolios pro Position
TURBO_BUY_THRESHOLD=0.45      # Kauft auch schwache Signale (Normal: 0.65)
TURBO_STOP_LOSS_PCT=0.12      # Weiterer SL damit Gewinne laufen können
TURBO_TAKE_PROFIT_PCT=0.40    # Ambitiöses TP-Ziel
TURBO_MAX_POSITIONS=15        # Mehr gleichzeitige Positionen erlaubt
