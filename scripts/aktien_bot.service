# ─────────────────────────────────────────────────────────────────────────────
# systemd Service-Datei für den Aktien-Bot
#
# Installation auf dem Server (einmalig als root):
#   cp /opt/Aktien/scripts/aktien_bot.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable aktien_bot
#   systemctl start aktien_bot
#
# Status prüfen:
#   systemctl status aktien_bot
#   journalctl -u aktien_bot -f
#
# Bot stoppen:
#   systemctl stop aktien_bot
# ─────────────────────────────────────────────────────────────────────────────
[Unit]
Description=Aktien Sentiment Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=aaron
WorkingDirectory=/opt/Aktien
ExecStart=/opt/Aktien/venv/bin/python /opt/Aktien/main.py
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

StandardOutput=append:/opt/Aktien/logs/bot.log
StandardError=append:/opt/Aktien/logs/bot.log

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
