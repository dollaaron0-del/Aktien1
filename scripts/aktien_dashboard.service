# systemd Service für das Web-Dashboard
#
# Installation (einmalig als root):
#   cp /opt/Aktien/scripts/aktien_dashboard.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable aktien_dashboard
#   systemctl start aktien_dashboard
#
# Dashboard lauscht NUR auf localhost (127.0.0.1) — Settings-Tab kann echte
# API-Keys lesen/schreiben, daher kein direkter Netzwerk-Zugriff (Roadmap 0.4).
# Zugriff von außen per SSH-Tunnel:
#   ssh -L 8503:localhost:8503 <server>
#   dann im Browser: http://localhost:8503
[Unit]
Description=Aktien Bot Web-Dashboard
After=network-online.target aktien_bot.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Aktien
ExecStart=/opt/Aktien/venv/bin/streamlit run /opt/Aktien/dashboard/app.py --server.port=8503 --server.address=127.0.0.1 --server.headless=true --browser.gatherUsageStats=false --server.runOnSave=true --server.fileWatcherType=poll
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

StandardOutput=append:/opt/Aktien/logs/dashboard.log
StandardError=append:/opt/Aktien/logs/dashboard.log

[Install]
WantedBy=multi-user.target
